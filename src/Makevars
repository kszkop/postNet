bregex_src = $(wildcard boost_regex/*.cpp)
bregex_objs = $(bregex_src:.cpp=.o)

CXX_STD = CXX11
PKG_LIBS = $(bregex_objs)

.PHONY: all clean

all: $(SHLIB)

$(SHLIB): $(bregex_objs)

clean:
	rm -f RcppExports.o pqsfinder.o $(bregex_objs) $(SHLIB)
